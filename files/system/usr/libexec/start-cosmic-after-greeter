#!/usr/bin/sh
# Workaround for pop-os/cosmic-comp#2690 and #2680 (black screen after the first login):
# the greeter's compositor can still hold the DRM device when the user's cosmic-comp starts,
# which fails with EBUSY and ends the session. Wait for the greeter's logind session to go
# away (max 5s, and never fail) so the GPU is free, then start the real session.
# Remove this, and the Exec= override in wayland-sessions/cosmic.desktop, once
# pop-os/cosmic-comp#2670 (retry busy drm devices) is in the packaged cosmic-comp.

i=0
while [ "$i" -lt 50 ] && loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "cosmic-greeter" && $6 == "greeter" { found = 1 } END { exit !found }'; do
    sleep 0.1
    i=$((i + 1))
done

exec /usr/bin/start-cosmic "$@"
